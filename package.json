    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.4",
    "eslint": "^9.32.0",
