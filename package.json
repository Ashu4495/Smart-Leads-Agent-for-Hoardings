{
  "name": "smart-leads-agent",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "frontend": "vite",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "backend": "venv\\Scripts\\python.exe -m uvicorn backend.api_server:app --host 127.0.0.1 --port 8000 --reload",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
